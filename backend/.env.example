# Language model behind the agent graph. Auto-detected: ANTHROPIC_API_KEY first, else a
# Gemini credential. Without either the app runs in direct tool mode: scenario chips work on
# live data, free-form chat and the simulator's narrated explanation are disabled.
ANTHROPIC_API_KEY=

# Optional: a Gemini key serves as the model provider when ANTHROPIC_API_KEY is absent
# or LLM_PROVIDER=gemini. Guideline retrieval is keyword (BM25) and needs no credential.
GEMINI_API_KEY=

# Optional overrides
# LLM_PROVIDER=auto               # auto | anthropic | gemini | none
# MODEL=claude-sonnet-4-6         # pin a model id; otherwise the first preferred model the key can see
# MODEL_LABEL=                    # what the UI shows for the model (default "live agent graph")
# LLM_HTTP_TIMEOUT_MS=45000       # per request; a stalled stream never hangs a turn
# FORCE_SCENARIOS=false           # true = chips always run the tools directly (demo-day safety)
