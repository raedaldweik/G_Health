# Gemini API key (aistudio.google.com/apikey). Without it the app runs in
# scripted mode: scenario chips work on live data, free-form chat is disabled.
GEMINI_API_KEY=

# Optional overrides
# MODEL=gemini-3.8-flash          # first available of: MODEL, 3.8-flash, 3.5-flash, 2.5-flash
# EMBED_MODEL=gemini-embedding-001
# FORCE_SCENARIOS=false           # true = chips always use the scripted engine (demo-day safety)
