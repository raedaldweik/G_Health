{
  "version": "1.0",
  "description": "Golden evaluation set for the Nabd agent. Each case runs through the agent (live Gemini) or the scripted engine and is scored on tool trajectory, groundedness (citations present when clinical), action safety (drafts go to the queue), numeric faithfulness (the answer quotes the true registry numbers) and latency/cost.",
  "cases": [
    {
      "id": "c_briefing",
      "persona": "clinician",
      "scenario_id": "c_briefing",
      "question": "Give me my morning briefing: review the panel and tell me who needs attention today.",
      "expected_tools": [
        "cohort_kpis",
        "stratify_cohort_risk",
        "find_care_gaps"
      ],
      "expected_agents": [
        "cohort_agent",
        "risk_agent",
        "pophealth_agent"
      ],
      "requires_citation": false,
      "requires_action": false,
      "fact_checks": [
        "patients",
        "hba1c_overdue_patients"
      ]
    },
    {
      "id": "c_deepdive",
      "persona": "clinician",
      "scenario_id": "c_deepdive",
      "question": "Review my highest-risk patient whose HbA1c is rising on metformin alone: summarise, score the risk, check the guideline, and draft what is needed.",
      "expected_tools": [
        "get_patient",
        "score_patient_risk",
        "search_guidelines",
        "draft_prescription"
      ],
      "expected_agents": [
        "cohort_agent",
        "risk_agent",
        "guideline_agent",
        "action_agent"
      ],
      "requires_citation": true,
      "requires_action": true,
      "fact_checks": []
    },
    {
      "id": "c_intensify",
      "persona": "clinician",
      "scenario_id": "c_intensify",
      "question": "How many type 2 patients with HbA1c above 8% are not on an SGLT2 inhibitor or GLP-1 agonist, what is closing that gap worth, and draft the review list.",
      "expected_tools": [
        "find_care_gaps",
        "simulate_policy",
        "search_guidelines",
        "draft_recall"
      ],
      "expected_agents": [
        "pophealth_agent",
        "risk_agent",
        "guideline_agent",
        "action_agent"
      ],
      "requires_citation": true,
      "requires_action": true,
      "fact_checks": [
        "intensification_gap_patients"
      ]
    },
    {
      "id": "c_screening",
      "persona": "clinician",
      "scenario_id": "c_screening",
      "question": "Which patients are overdue for retinal screening, where is the backlog, and draft the recall.",
      "expected_tools": [
        "find_care_gaps",
        "search_guidelines",
        "draft_recall"
