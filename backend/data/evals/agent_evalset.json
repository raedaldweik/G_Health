    {
      "id": "e_national",
      "persona": "executive",
      "scenario_id": "e_national",
      "question": "Give me the national glycaemic picture: trend, control rates, and facility spread.",
      "expected_tools": [
        "cohort_kpis",
        "facility_benchmark"
      ],
      "expected_agents": [
        "cohort_agent"
      ],
      "requires_citation": false,
      "requires_action": false,
      "fact_checks": [
        "mean_hba1c",
        "pct_well_controlled"
      ]
    },
    {
      "id": "e_cost",
      "persona": "executive",
